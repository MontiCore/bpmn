package de.monticore.bpmn;

import de.monticore.siunit.SIUnits;

grammar WorkflowWithMetrics extends Workflow, SIUnits {
    start WorkflowCompilationUnit;

    MetricsBlock implements FlowElement =
        "metrics" "{" ( MetricDef ";")* "}"
        "applied" "to" "{"
          referencedTask:(Name@WFActivity || "," )+ ";"
        "}";
    MetricDef = Name ":" SIUnit;
}
